# syntax=docker/dockerfile:1
# REYD Yiddish TTS — RunPod Serverless Endpoint
#
# The REYD model checkpoints are downloaded automatically from Figshare
# (https://figshare.com/articles/software/REYD_demo_files/19350539)
)
# during the Docker build. No manual step required.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3.10 python3.10-dev python3-pip \
    git wget curl unzip file ffmpeg \
    libsndfile1 libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip && \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python3

# PyTorch 2.7+ with CUDA 12.8 — bundles its own CUDA runtime (sm_120 support)
RUN pip install --no-cache-dir torch \
    --index-url https://download.pytorch.org/whl/cu128

# Clone REYD FastSpeech2 fork
RUN git clone https://github.com/REYD-TTS/FastSpeech2 /app/FastSpeech2

WORKDIR /app/FastSpeech2

RUN pip install --no-cache-dir \
    numpy==1.24.3 \
    scipy==1.11.1 \
    librosa==0.10.0 \
    soundfile==0.12.1 \
    inflect==7.0.0 \
    Unidecode==1.3.6 \
    matplotlib==3.7.2 \
    tqdm==4.65.0 \
    runpod

# Download REYD pre-trained checkpoints from Figshare (public, no auth required).
# The article zip contains .pth.tar checkpoint files and config/preprocessed data.
RUN mkdir -p /app/FastSpeech2/output/ckpt/yivo_respelled && \
    mkdir -p /tmp/reyd_download && \
    echo "[build] Downloading REYD model files from Figshare..." && \
    wget -q --content-disposition \
         "https://figshare.com/ndownloader/articles/19350539/versions/1" \
         -O /tmp/reyd_download/reyd.zip && \
    echo "[build] Extracting..." && \
    unzip -q /tmp/reyd_download/reyd.zip -d /tmp/reyd_download/extracted && \
    echo "[build] Locating checkpoint files..." && \
    find /tmp/reyd_download/extracted -name "*.pth.tar" -exec cp {} /app/FastSpeech2/output/ckpt/yivo_respelled/ \; && \
    echo "[build] Checkpoints installed:" && \
    ls /app/FastSpeech2/output/ckpt/yivo_respelled/ && \
    rm -rf /tmp/reyd_download

COPY runpod/tts_server.py /app/tts_server.py

CMD ["python", "/app/tts_server.py"]
