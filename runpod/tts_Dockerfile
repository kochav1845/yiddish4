# syntax=docker/dockerfile:1
# REYD Yiddish TTS — RunPod Pod (persistent HTTP server on port 8000)
# Checkpoints are downloaded from Figshare on first startup if not already
# present. Mount a RunPod Network Volume at /runpod-volume to persist them.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3.10 python3.10-dev python3-pip \
    git wget curl unzip file ffmpeg \
    libsndfile1 libsndfile1-dev \
    build-essential gfortran \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip && \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python3

RUN pip install --no-cache-dir torch \
    --index-url https://download.pytorch.org/whl/cu128

RUN git clone https://github.com/REYD-TTS/FastSpeech2 /app/FastSpeech2

WORKDIR /app/FastSpeech2

RUN pip install --no-cache-dir \
    numpy==1.24.3 \
    scipy==1.11.1 \
    librosa==0.10.0 \
    soundfile==0.12.1 \
    inflect==7.0.0 \
    Unidecode==1.3.6 \
    matplotlib==3.7.2 \
    tqdm==4.65.0 \
    g2p-en \
    pyworld \
    PyYAML \
    scikit-learn \
    numba \
    pypinyin \
    fastapi \
    uvicorn[standard] \
    pydantic

COPY runpod/tts_server.py /app/tts_server.py

EXPOSE 8000

CMD ["python", "/app/tts_server.py"]
