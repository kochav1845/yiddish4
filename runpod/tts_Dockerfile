# syntax=docker/dockerfile:1
# REYD Yiddish TTS - RunPod Serverless Endpoint
# Checkpoints are downloaded automatically from Figshare during docker build.
# No manual steps or environment variables required.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3.10 python3.10-dev python3-pip \
    git wget curl unzip file ffmpeg \
    libsndfile1 libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip && \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python3

RUN pip install --no-cache-dir torch \
    --index-url https://download.pytorch.org/whl/cu128

RUN git clone https://github.com/REYD-TTS/FastSpeech2 /app/FastSpeech2

WORKDIR /app/FastSpeech2

RUN pip install --no-cache-dir \
    numpy==1.24.3 \
    scipy==1.11.1 \
    librosa==0.10.0 \
    soundfile==0.12.1 \
    inflect==7.0.0 \
    Unidecode==1.3.6 \
    matplotlib==3.7.2 \
    tqdm==4.65.0 \
    runpod

# Download REYD pre-trained checkpoints from Figshare via their public API.
# The API returns individual file download URLs - more reliable than the bulk endpoint.
RUN mkdir -p /app/FastSpeech2/output/ckpt/yivo_respelled && \
    mkdir -p /tmp/reyd_download && \
    echo "[build] Fetching file list from Figshare API..." && \
    python3 -c "\
import urllib.request, json, os; \
resp = urllib.request.urlopen('https://api.figshare.com/v2/articles/19350539/files'); \
files = json.loads(resp.read()); \
print(f'[build] Found {len(files)} files in article'); \
for f in files: \
    name = f['name']; \
    url = f['download_url']; \
    dest = f'/tmp/reyd_download/{name}'; \
    print(f'[build] Downloading {name} ...'); \
    urllib.request.urlretrieve(url, dest); \
    print(f'[build] Done: {name}'); \
" && \
    echo "[build] Copying checkpoint files..." && \
    find /tmp/reyd_download -name "*.pth.tar" -exec cp {} /app/FastSpeech2/output/ckpt/yivo_respelled/ \; && \
    echo "[build] Checkpoints installed:" && \
    ls /app/FastSpeech2/output/ckpt/yivo_respelled/ && \
    rm -rf /tmp/reyd_download

COPY runpod/tts_server.py /app/tts_server.py

CMD ["python", "/app/tts_server.py"]
